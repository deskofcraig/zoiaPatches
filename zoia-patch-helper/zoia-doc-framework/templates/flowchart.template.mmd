%% ── AUDIO CONNECTIONS ──
%% Format: SOURCE -->|"audio <strength>% → <destination port>"| DEST
AIN -->|"audio 100% → dry split"| DVCA
AIN -->|"audio 100% → {{PROC}} audio_in"| PROC
PROC -->|"audio 100%"| WVCA
WVCA -->|"audio 100% → in_A"| SMIX
DVCA -->|"audio 100% → in_B"| SMIX
SMIX -->|"audio stereo 100%"| AOUT

%% ── CV CONNECTIONS ──
%% Format: SOURCE -.->|"cv <value> → <destination block>"| DEST
K_KNOB1 -.->|"cv <default> → <param>_cv"| PROC
K_KNOB2 -.->|"cv <default> → <param>_cv"| PROC
S_BYPASS -.->|"cv toggle → gain override 0"| WVCA

%% ── STYLES ──
%% Keep these classDef blocks — they match the HTML design system
classDef io      fill:#001b23,stroke:#00BFFF,color:#d4e4ff
classDef pitch   fill:#002300,stroke:#00FF00,color:#b8f5cb
classDef res     fill:#230000,stroke:#FF0000,color:#ffd4d4
classDef body    fill:#003a3a,stroke:#00cccc,color:#b0f0f0
classDef rev     fill:#3a003a,stroke:#dd44dd,color:#f5b8f5
classDef mix     fill:#170b00,stroke:#FFA500,color:#d4d4ff
classDef ctrl    fill:#1c1c1c,stroke:#FFFFFF,color:#f0f0f0
classDef val     fill:#232300,stroke:#FFFF00,color:#fff0a0

%% Apply classes to module nodes:
class AIN,AOUT io
class WVCA,DVCA,SMIX mix
class K_KNOB1,K_KNOB2,S_BYPASS ctrl
