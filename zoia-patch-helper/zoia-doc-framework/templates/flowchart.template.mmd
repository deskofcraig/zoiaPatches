%% ZOIA Patch Signal Flow — Mermaid Flowchart Template
%%
%% INSTRUCTIONS:
%% 1. Replace {{PATCH_NAME}} and all {{PLACEHOLDERS}} throughout
%% 2. Add/remove subgraphs to match your page count (P1–P6)
%% 3. Node ID convention: K_<KNOB_ID>, S_<STOMP_ID>, module abbreviations
%% 4. Audio connections: -->  with solid label
%% 5. CV connections:   -.-> with dashed label
%% 6. Group modules into subgraphs by page
%% 7. Apply classDef styles at the bottom — match colour coding in docs
%% ══════════════════════════════════════════════════════════════

subgraph P1["P1 · UI CONTROLS"]
  direction TB
  %% ── Knobs (Value modules) ──
  %% K_<ID>["Knob <DISPLAY_NAME>\n<default> <unit>\nCC<n>"]
  K_KNOB1["Knob KNOB_NAME\n<default> <unit>\nCC<n>"]
  K_KNOB2["Knob KNOB_NAME\n<default> <unit>\nCC<n>"]
  %% ── Stomps ──
  %% S_<ID>["Stomp <DISPLAY_NAME>\n<mode> CC<n>"]
  S_BYPASS["Stomp BYPASS\ntoggle CC80"]
end

subgraph P2["P2 · I/O + MIX BUS"]
  direction TB
  AIN["Audio Input\n{{INPUT_LABEL}}\n<dsp>%"]
  WVCA["VCA WET VCA\n<default>% gain"]
  DVCA["VCA DRY VCA\n<default>% gain"]
  SMIX["Mixer STEREO MIX"]
  AOUT["Audio Output\nSTEREO OUT\n<dsp>%"]
end

subgraph P3["P3 · {{P3_NAME}}"]
  direction TB
  %% Add modules for page 3
  PROC["{{Module}} {{LABEL}}\n{{detail}}\n<dsp>%"]
end

