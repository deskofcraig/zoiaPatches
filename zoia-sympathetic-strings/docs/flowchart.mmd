%% ── AUDIO CONNECTIONS ──
AIN -->|"audio 100% → SOFT LIMITER audio_in"| SLIM
AIN -->|"audio 100% → TRACKER audio_in"| PDET
AIN -->|"audio 100% dry split → DRY VCA audio_in"| DVCA

SLIM -->|"audio 100%"| V1
SLIM -->|"audio 85%"| V2
SLIM -->|"audio 70%"| V3
SLIM -->|"audio 55%"| V4
SLIM -->|"audio 90%"| DLL
SLIM -->|"audio 90%"| DLR

V1 & V2 & V3 & V4 & DLL & DLR -->|"audio 100% → sum_in"| DLPF

DLPF -->|"audio 100%"| TEQP
TEQP -->|"audio 100%"| CHOR
CHOR -->|"audio stereo 100%"| RSND
RSND -->|"audio 100%"| RVBM
RVBM -->|"audio 100%"| RRET
RRET -->|"audio 100%"| WVCA
WVCA -->|"audio 100% → in_A"| SMIX
DVCA -->|"audio 100% → in_B"| SMIX
SMIX -->|"audio stereo 100%"| AOUT

%% ── CV CONNECTIONS ──
PDET -.->|"cv pitch_cv → cv_in_a"| CVOFF
PDET -.->|"cv gate → trigger_in"| SNH
PDET -.->|"cv gate → trigger_in"| ADSR
CVOFF -.->|"cv → signal_in"| SNH
SNH -.->|"cv pitch 0st → pitch_cv_in"| V1
SNH -.->|"cv → cv_in"| VH
SNH -.->|"cv → cv_in_a (+7st adder)"| V4A
SNH -.->|"cv → freq_cv"| DLL
SNH -.->|"cv → freq_cv"| DLR
VH -.->|"cv +12st → pitch_cv_in"| V2
VH -.->|"cv +19st → pitch_cv_in"| V3
V4A -.->|"cv → pitch_cv_in"| V4
VD -.->|"cv 2.8s 100%"| V1
VD -.->|"cv 2.4s 85%"| V2
VD -.->|"cv 2.0s 70%"| V3
VD -.->|"cv 2.8s 100%"| V4
ADSR -.->|"cv env 100%"| V1
ADSR -.->|"cv env → env_in"| VO
ADSR -.->|"cv env 100%"| V4
VO -.->|"cv 80% → level_cv_in"| V2
VO -.->|"cv 55% → level_cv_in"| V3
VB -.->|"cv +2.2dB → low_shelf_cv"| TEQP
VB -.->|"cv 280Hz → mid_freq_cv"| TEQP
VB -.->|"cv 65% → depth_cv"| CHOR

%% ── KNOB CVs ──
K_PITCH -.->|"cv 0st → cv_in_b"| CVOFF
K_OT -.->|"cv 45% → scale_cv"| VO
K_SP -.->|"cv 9ms → time_cv"| DLL
K_SP -.->|"cv 11ms → time_cv"| DLR
K_DA -.->|"cv 3.5kHz → cutoff_cv"| DLPF
K_DC -.->|"cv 2.8s → cv_in"| VD
K_PS -.->|"cv 55% → cv_in"| VB
K_RL -.->|"cv 28% → gain_cv"| RSND
K_WV -.->|"cv 45% → gain_cv"| WVCA
K_DV -.->|"cv 85% → gain_cv"| DVCA
S_BY -.->|"cv toggle → gain override 0"| WVCA
S_DK -.->|"cv → cv_in min"| VD

